# ---------------------------------------------------------------------------
# Panel Viewer — environment configuration example.
# Copy this file to `.env` and adjust values as needed.
# NEVER commit a real `.env` file with credentials.
# ---------------------------------------------------------------------------

# --- Database (embedded, no Docker, no install) -------------------------------
# Local folder holding the PGlite (embedded PostgreSQL) data files.
# The API creates it on first start; back it up or delete it like any folder.
# Relative paths resolve against the repo root. A leftover
# `postgres://…` connection string is rejected with a clear error.
DATABASE_URL=data/pglite

# --- API server -------------------------------------------------------------
# Port the Hono API listens on.
#
# For bare-IP LAN access (other devices type just `http://<your-ip>` with no
# port — Bun only, no Docker), use `bun run lan`, which builds the web app
# and serves everything on port 80. Equivalent manual form:
# `bun run build` then `PORT=80 bun run start`.
PORT=3001

# Allowed CORS origin(s) for the web app. Comma-separated list supported.
#
# This only takes effect in production/test. In development the API allows
# every origin by default, so `bun run dev` works on any LAN device with zero
# config — the Vite server already listens on 0.0.0.0 (`host: true`), and the
# API matches. Set this explicitly for production deployments (e.g.
# docker-compose) to lock down which browser origins may call the API.
CORS_ORIGIN=http://localhost:5173

# Set to "production" in deployed environments (disables dev logging, tightens
# error responses).
NODE_ENV=development

# Override the LAN address reported by /api/health for shareable links (QR
# codes / copy-link in the UI). Auto-detection picks the adapter the OS uses
# to reach the internet, but Docker/WSL/VMware can shadow the real one with
# virtual interfaces (172.x / 192.168.x). Set this to your machine's real LAN
# IP (e.g. 10.62.204.243) if the shared link is unreachable from other devices.
# SHARE_LAN_ADDRESS=

# --- Panel source: MangaKatana ----------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN subdomains) — this is the SSRF allowlist.
SOURCE_MANGAKATANA_BASE_URL=https://mangakatana.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_MANGAKATANA_ENABLED=true

# --- Panel source: NihonKuni --------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains) — this is the SSRF allowlist.
SOURCE_NIHONKUNI_BASE_URL=https://nihonkuni.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_NIHONKUNI_ENABLED=true

