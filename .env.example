# ---------------------------------------------------------------------------
# Panel Viewer — environment configuration example.
# Copy this file to `.env` and adjust values as needed.
# NEVER commit a real `.env` file with credentials.
# ---------------------------------------------------------------------------

# --- Database (embedded, no Docker, no install) -------------------------------
# Local SQLite file holding the embedded database (Bun's built-in bun:sqlite).
# The API creates it on first start; back it up or delete it like any file.
# Relative paths resolve against the repo root. A leftover
# `postgres://…` connection string is rejected with a clear error.
DATABASE_URL=data/panel.db

# --- API server -------------------------------------------------------------
# Port the Hono API listens on.
#
# For bare-IP LAN access (other devices type just `http://<your-ip>` with no
# port — Bun only, no Docker), use `bun run lan`, which builds the web app
# and serves everything on port 80. Equivalent manual form:
# `bun run build` then `PORT=80 bun run start`.
PORT=3001

# Allowed CORS origin(s) for the web app. Comma-separated list supported.
#
# This only takes effect in production/test. In development the API allows
# every origin by default, so `bun run dev` works on any LAN device with zero
# config — the Vite server already listens on 0.0.0.0 (`host: true`), and the
# API matches. Set this explicitly for production deployments (e.g.
# docker-compose) to lock down which browser origins may call the API.
CORS_ORIGIN=http://localhost:5173

# Set to "production" in deployed environments (disables dev logging, tightens
# error responses).
NODE_ENV=development

# Override the LAN address reported by /api/health for shareable links (QR
# codes / copy-link in the UI). Auto-detection picks the adapter the OS uses
# to reach the internet, but Docker/WSL/VMware can shadow the real one with
# virtual interfaces (172.x / 192.168.x). Set this to your machine's real LAN
# IP (e.g. 10.62.204.243) if the shared link is unreachable from other devices.
# SHARE_LAN_ADDRESS=

# --- Access control (see plans/SECURITY_REMEDIATIONS.md R2) ------------------
# Shared access token required from non-localhost callers. When set, every
# /api request from another device must present it — the web client claims
# it from the share-link (`http://<ip>/?token=<value>`) automatically, and
# `bun run lan` generates/persists one in data/lan-token when this is unset.
# Leave unset on the host PC (loopback callers never need it).
# Minimum 16 characters.
# ACCESS_TOKEN=

# Bind the server to every interface (0.0.0.0) even WITHOUT an access token.
# Default false — without a token the API only listens on localhost, so LAN
# exposure is always a deliberate choice (`bun run lan` sets this itself).
# BIND_ALL=false

# Trust X-Forwarded-For / X-Real-IP when keying the rate limiter. Only enable
# this when a reverse proxy YOU control sits in front of the API — on a direct
# connection those headers are client-settable and would let a caller reset
# its own rate bucket every request.
# TRUST_PROXY=false

# --- Panel source: MangaKatana ----------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN subdomains) — this is the SSRF allowlist.
SOURCE_MANGAKATANA_BASE_URL=https://mangakatana.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_MANGAKATANA_ENABLED=true

# --- Panel source: NihonKuni --------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains) — this is the SSRF allowlist.
SOURCE_NIHONKUNI_BASE_URL=https://nihonkuni.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_NIHONKUNI_ENABLED=true

# --- Panel source: Rawkuma ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains) — this is the SSRF allowlist.
SOURCE_RAWKUMA_BASE_URL=https://rawkuma.net

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWKUMA_ENABLED=true

# --- Panel source: RawSakura ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains) — this is the SSRF allowlist.
SOURCE_RAWSAKURA_BASE_URL=https://rawsakura.org

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWSAKURA_ENABLED=true

# --- Panel source: Hiperdex ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains, including image CDN *.r2d2storage.com) — this is the SSRF allowlist.
SOURCE_HIPERDEX_BASE_URL=https://hiperdex.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_HIPERDEX_ENABLED=true

# The SPA api's site token, sent as the `x-cfg-auth` header. Publicly
# distributed by the site to every visitor — not a secret. Kept here so a
# site-side rotation is a config change instead of a code change.
SOURCE_HIPERDEX_API_KEY=yceqt7qgu004

# --- Panel source: MangaRead ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# subdomains) — this is the SSRF allowlist.
SOURCE_MANGAREAD_BASE_URL=https://www.mangaread.org

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_MANGAREAD_ENABLED=true

# --- Panel source: Toonily ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN static.tnlycdn.com) — this is the SSRF allowlist.
SOURCE_TOONILY_BASE_URL=https://toonily.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_TOONILY_ENABLED=true

# --- Panel source: RawDex -----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN img.rawdex.net) — this is the SSRF allowlist.
SOURCE_RAWDEX_BASE_URL=https://rawdex.net

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWDEX_ENABLED=true

# --- Panel source: RawUwU -------------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN mirror *.b-cdn.net) — this is the SSRF allowlist.
SOURCE_RAWUWU_BASE_URL=https://rawuwu.net

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWUWU_ENABLED=true

# --- Panel source: RoliaScan ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN tovahala.lol) — this is the SSRF allowlist.
#
# NOTE: the image CDN rotates subdomains over time (azabria → azc1bia → …), and
# the previous host keeps its DNS record killed. The adapter learns every host
# the site itself serves (from freshly parsed pages) and, when an image fetch
# dies on one host, retries the same path on the other known hosts — so stale
# bookmarked/cached URLs on a rotated host recover automatically. No config
# needed; the allowlist above already covers any *.tovahala.lol subdomain.
SOURCE_ROLIASCAN_BASE_URL=https://roliascan.xyz

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_ROLIASCAN_ENABLED=true

# Timeout (ms) for every outbound request to the source.
SOURCE_REQUEST_TIMEOUT_MS=15000

# Automatic retries on a TRANSIENT failure (timeout, connection/DNS/TLS error,
# HTTP 429 or 5xx) before surfacing an error to the client. Each attempt gets a
# fresh timeoutMs budget, so worst-case latency is (retryCount + 1) * timeoutMs.
SOURCE_REQUEST_RETRY_COUNT=2

# Base delay (ms) for the first retry; each subsequent attempt doubles it
# (plus ±50% jitter so concurrent retries don't thunder-herd).
SOURCE_REQUEST_RETRY_BASE_DELAY_MS=500

# Split response cap (bytes). Listings are KBs of HTML — a rogue multi-MB page
# used to become a multi-MB JS string, so text fails fast at 3 MiB while
# images keep the full 16 MiB (some sources serve 13MB+ original covers and
# large stitched pages — anything above the cap fails every retry and shows
# as a permanent broken image).
SOURCE_MAX_TEXT_BYTES=3145728
SOURCE_MAX_IMAGE_BYTES=16777216

# --- Caching (in-memory, per API process) ------------------------------------
# TTL for search results (ms). Search changes often: keep short.
CACHE_TTL_SEARCH_MS=120000
# TTL for panel metadata (ms).
CACHE_TTL_PANEL_MS=600000
# TTL for chapter lists (ms).
CACHE_TTL_CHAPTERS_MS=300000
# TTL for chapter pages (ms). Page URLs are tokenized but long-lived.
CACHE_TTL_PAGES_MS=1800000
# Max entries in the in-memory source-response cache. Each entry can hold a
# full listing or chapter page list — 1000 pins hundreds of MB after a long
# browse; 100 keeps recent revisits hot for a single user with a capped heap
# (nihonkuni chapter lists with 1000+ entries are the largest payloads here).
CACHE_MAX_ENTRIES=100
# Max bytes in the same cache (sized by JSON length, oldest evicted first).
# Either this or CACHE_MAX_ENTRIES bounds the heap.
CACHE_MAX_BYTES=33554432

# --- Web frontend -------------------------------------------------------------
# Base URL the web app uses to reach the API. In dev, Vite proxies /api to the
# API server, so the default (empty) is fine. In the all-in-one Docker image
# the API serves the frontend, so this stays empty there as well.
VITE_API_BASE_URL=

# --- Proxied image cache (on-disk, local data directory) ----------------------
# Every cover / chapter image the client requests through the API proxy is
# cached here, so revisit + warm-up hits are served from disk with no upstream
# fetch. Cached images survive restarts; the folder lives next to the
# database under data/ so one backup covers everything.
#
# The cap is computed relative to the host's available disk at runtime:
# maxFraction of currently-available space, clamped between minBytes and
# maxBytes. Old entries (oldest access time first) are evicted whenever the
# cap would be exceeded — so a small host disk can never balloon.
#
# A custom cap can also be set at runtime from the webapp (Image cache →
# Maximum size); it is persisted beside the cache dir, survives restarts,
# and takes precedence over the computed value until cleared.
IMAGE_CACHE_DIR=data/.imagecache
  IMAGE_CACHE_MAX_FRACTION=0.5
  IMAGE_CACHE_MIN_BYTES=268435456
  IMAGE_CACHE_MAX_BYTES=8589934592
# Max concurrent upstream image fetches through /api/source-image. Cover grids
# fire dozens of requests at once and each miss buffers a whole image in heap
# (the transient 300MB+ spike). Disk hits bypass the limiter, so revisits
# stay instant; fewer parallel fetches also means fewer source 429s/retries.
# Sized with SOURCE_MAX_IMAGE_BYTES (2 x 16 MiB caps the transient heap at 32 MiB).
# Can be overridden at runtime from the webapp (reader settings → Download
# concurrency); the override is persisted beside the cache dir, survives
# restarts, and takes precedence until reset to the default.
IMAGE_PROXY_CONCURRENCY=2
# Stream upstream image-proxy misses through an isolated short-lived child
# process instead of fetching in-process (contains intermittent native RSS
# grabs below app code — the OS reclaims the child's pages on exit).
# `false` restores the legacy in-process streaming path.
# IMAGE_FETCH_ISOLATED=true

# --- Data import (bun run db:import) -------------------------------------------
# Path to the COPY-block export the import script loads. Relative paths resolve
# against the repo root. The file is not committed to the repo, so point this
# at your own export (or pass the path as the first CLI argument).
# Old PostgreSQL-era `panel_viewer_export.sql` files import 1:1.
# DUMP_PATH=panel_viewer_export.sql

# --- On-exit + periodic auto-backup ------------------------------------------------
# Folder (created on demand) where a compressed SQL dump of the embedded
# database is written each time the server shuts down. Relative paths resolve
# against the repo root. Defaults to `data/.backup` (backups are never
# deleted automatically). Empty value disables the backup entirely.
# BACKUP_DIR=data/.backup
# Scope of that backup: `full` dumps every table (including the
# reader/search/prefetch caches, tens of MB), `minimal` dumps bookmark data
# only (bookmarks, folders, progress, lists, ratings, tags — no caches).
# Minimal files get a `-minimal` filename infix. Picked at startup:
# `lan.bat` asks Full/Minimal on launch (or takes it as its first argument)
# and `bun run lan` takes `--backup-scope`.
# BACKUP_SCOPE=full
# Interval (ms) between automatic backups while the server is running, so an
# hour of data is never lost to a crash or power cut (the on-exit backup only
# fires on a clean shutdown). Default 3600000 (1 hour); `0` disables the
# periodic backup (the on-exit backup still runs).
# BACKUP_INTERVAL_MS=3600000


