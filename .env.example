SOURCE_MANGAREAD_BASE_URL=https://www.mangaread.org

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_MANGAREAD_ENABLED=true

# --- Panel source: Toonily ----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN static.tnlycdn.com) — this is the SSRF allowlist.
SOURCE_TOONILY_BASE_URL=https://toonily.com

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_TOONILY_ENABLED=true

# --- Panel source: RawDex -----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN img.rawdex.net) — this is the SSRF allowlist.
SOURCE_RAWDEX_BASE_URL=https://rawdex.net

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWDEX_ENABLED=true

# --- Panel source: KaliScan -----------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN cdn.1stmangago.com) — this is the SSRF allowlist.
SOURCE_KALISCAN_BASE_URL=https://kaliscan.io

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_KALISCAN_ENABLED=true

# --- Panel source: RawUwU -------------------------------------------------------
# Base URL of the source. The API will ONLY fetch from this host (and its
# image CDN mirror *.b-cdn.net) — this is the SSRF allowlist.
SOURCE_RAWUWU_BASE_URL=https://rawuwu.net

# Set to "false" to disable this source entirely (API will return 503 for
# source-backed endpoints).
SOURCE_RAWUWU_ENABLED=true

# Timeout (ms) for every outbound request to the source.
SOURCE_REQUEST_TIMEOUT_MS=15000

# Automatic retries on a TRANSIENT failure (timeout, connection/DNS/TLS error,
# HTTP 429 or 5xx) before surfacing an error to the client. Each attempt gets a
# fresh timeoutMs budget, so worst-case latency is (retryCount + 1) * timeoutMs.
SOURCE_REQUEST_RETRY_COUNT=2

# Base delay (ms) for the first retry; each subsequent attempt doubles it
# (plus ±50% jitter so concurrent retries don't thunder-herd).
SOURCE_REQUEST_RETRY_BASE_DELAY_MS=500

# --- Caching (in-memory, per API process) ------------------------------------
# TTL for search results (ms). Search changes often: keep short.
CACHE_TTL_SEARCH_MS=120000
# TTL for panel metadata (ms).
CACHE_TTL_PANEL_MS=600000
# TTL for chapter lists (ms).
CACHE_TTL_CHAPTERS_MS=300000
# TTL for chapter pages (ms). Page URLs are tokenized but long-lived.
CACHE_TTL_PAGES_MS=1800000

# --- Web frontend -------------------------------------------------------------
# Base URL the web app uses to reach the API. In dev, Vite proxies /api to the
# API server, so the default (empty) is fine. In the all-in-one Docker image
# the API serves the frontend, so this stays empty there as well.
VITE_API_BASE_URL=

# --- Proxied image cache (on-disk, local data directory) ----------------------
# Every cover / chapter image the client requests through the API proxy is
# cached here, so revisit + warm-up hits are served from disk with no upstream
# fetch. Cached images survive restarts; the folder lives next to the
# database under data/ so one backup covers everything.
#
# The cap is computed relative to the host's available disk at runtime:
# maxFraction of currently-available space, clamped between minBytes and
# maxBytes. Old entries (oldest access time first) are evicted whenever the
# cap would be exceeded — so a small host disk can never balloon.
#
# A custom cap can also be set at runtime from the webapp (Image cache →
# Maximum size); it is persisted beside the cache dir, survives restarts,
# and takes precedence over the computed value until cleared.
IMAGE_CACHE_DIR=data/.imagecache
  IMAGE_CACHE_MAX_FRACTION=0.5
  IMAGE_CACHE_MIN_BYTES=268435456
  IMAGE_CACHE_MAX_BYTES=8589934592

# --- Data import (bun run db:import) -------------------------------------------
# Path to the `pg_dump` export the import script loads. Relative paths resolve
# against the repo root. The file is not committed to the repo, so point this
# at your own export (or pass the path as the first CLI argument).
# DUMP_PATH=panel_viewer_export.sql

# --- On-exit auto-backup --------------------------------------------------------
# Folder (created on demand) where a compressed SQL dump of the embedded
# database is written each time the server shuts down. Relative paths resolve
# against the repo root. Defaults to `data/.backup` (backups are never
# deleted automatically). Empty value disables the backup entirely.
# BACKUP_DIR=data/.backup
# Scope of that backup: `full` dumps every table (including the
# reader/search/prefetch caches, tens of MB), `minimal` dumps bookmark data
# only (bookmarks, folders, progress, lists, ratings, tags — no caches).
# Minimal files get a `-minimal` filename infix. Picked at startup:
# `lan.bat` asks Full/Minimal on launch (or takes it as its first argument)
# and `bun run lan` takes `--backup-scope`.
# BACKUP_SCOPE=full


