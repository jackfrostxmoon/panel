# This is a Bun workspace -- see package.json "engines".npm (deliberately
# unsatisfiable, e.g. ">=999.0.0"). With engine-strict enabled, any npm
# command that resolves the root package (npm install, npm update, npm ci,
# npm prune, ...) fails hard with EBADENGINE instead of silently rewriting
# the tree using npm's hoisting rules. npm's own lifecycle hooks (preinstall,
# postinstall, preupdate, ...) do NOT fire for `npm update`, so a script guard
# alone cannot stop it -- the engine mismatch is what actually blocks it.
engine-strict=true